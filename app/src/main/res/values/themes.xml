<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/values/themes.xml -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MeraKisan" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">#0A3D0A</item>
        <item name="colorOnPrimary">@color/surface_white</item>

        <!-- Secondary Accent -->
        <item name="colorSecondary">@color/primary_green_light</item>
        <item name="colorSecondaryVariant">#1B5E20</item>
        <item name="colorOnSecondary">@color/surface_white</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status & Navigation Bars -->
        <item name="android:statusBarColor">@color/primary_green</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
