<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/item_favorite_product_card.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#C8E6C9"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Product Thumbnail -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFavProductThumb"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="#E8F5E9"
            android:contentDescription="फसल की तस्वीर"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
            tools:src="@android:drawable/ic_menu_gallery" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title & Remove Action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFavProductName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#1B5E20"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="देशी सोयाबीन (JS 335)" />

                <ImageButton
                    android:id="@+id/btnRemoveFavorite"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="पसंदीदा से हटाएं"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#D32F2F" />
            </LinearLayout>

            <!-- Price (Calculated from Integer Paise) -->
            <TextView
                android:id="@+id/tvFavProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="₹46 / kg" />

            <!-- Seller & Location (Privacy-First) -->
            <TextView
                android:id="@+id/tvFavProductSeller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#616161"
                android:textSize="12sp"
                tools:text="किसान: रामलाल • गरोठ, मंदसौर" />

            <!-- Stock Availability -->
            <TextView
                android:id="@+id/tvFavProductStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#757575"
                android:textSize="11sp"
                tools:text="उपलब्ध स्टॉक: 20 kg" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
