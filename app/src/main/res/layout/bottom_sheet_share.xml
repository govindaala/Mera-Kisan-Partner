<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/bottom_sheet_share.xml -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Drag Handle -->
            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:layout_marginBottom="14dp"
                android:background="#E0E0E0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📢 फसल प्रचार व सोशल शेयरिंग"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShareCropTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#616161"
                android:textSize="13sp"
                tools:text="देशी सोयाबीन (JS 335) • मंदसौर" />

            <!-- Poster Live Preview Frame -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#F1F8E9"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#C8E6C9"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivPosterPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="पोस्टर प्रीव्यू"
                        android:scaleType="fitCenter" />

                    <ProgressBar
                        android:id="@+id/pbPosterGenerating"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="#1B5E20" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sharing Channels Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="शेयर करने का माध्यम चुनें:"
                android:textColor="#212121"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- WhatsApp Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareWhatsApp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="WhatsApp"
                    android:textColor="#2E7D32"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#2E7D32" />

                <!-- Download/Save Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadPoster"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="पोस्टर सहेजें"
                    android:textColor="#1B5E20"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="#1B5E20" />

                <!-- Universal Android Share Sheet -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareMore"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1B5E20"
                    android:text="अन्य शेयर"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
