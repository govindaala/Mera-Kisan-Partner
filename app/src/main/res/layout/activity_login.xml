<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <!-- टॉप हेडर ब्रांडिंग -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#166534"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌱 Mera Kisan Partner"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="किसान डिजिटल मंडी साथी पोर्टल • मंदसौर (म.प्र.)"
            android:textColor="#BBF7D0"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. मुख्य स्विच टैब्स: सीधे लॉगिन vs नया खाता -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#E2E8F0"
                android:orientation="horizontal"
                android:padding="3dp">

                <Button
                    android:id="@+id/btnTabSwitchLogin"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#166534"
                    android:text="🔑 सीधे लॉगिन करें"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTabSwitchSignup"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:text="➕ नया खाता बनाएँ"
                    android:textColor="#475569"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- लोडिंग इंडिकेटर -->
            <ProgressBar
                android:id="@+id/loginProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- ================= कार्ड 1: सीधे लॉगिन (मोबाइल + 6-अंक PIN) ================= -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDirectLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="किसान साथी लॉगिन"
                        android:textColor="#166534"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="अपना पंजीकृत 10-अंकों का मोबाइल नंबर और 6-अंकों का PIN डालें:"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="📱 मोबाइल नंबर"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtDirectLoginPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="उदा. 8871291126"
                        android:inputType="phone"
                        android:maxLength="10" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="🔑 6-अंकों का गुप्त PIN"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtDirectLoginPin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="••••••"
                        android:inputType="numberPassword"
                        android:maxLength="6" />

                    <Button
                        android:id="@+id/btnSubmitDirectLogin"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#166534"
                        android:text="🚀 सीधे लॉगिन करें"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnDirectForgotPin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:text="❓ PIN भूल गए? यहाँ टैप करके रीसेट करें"
                        android:textColor="#DC2626"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ================= कार्ड 2: नया खाता बनाएँ (Sign Up) ================= -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="नया किसान पंजीकरण"
                        android:textColor="#166534"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnGoogleSignUp"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#0284C7"
                        android:text="G  Google खाते से विवरण भरें"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtGoogleStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#059669"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="किसान का नाम"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtRegName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="उदा. गोविंद पाटीदार" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="गाँव का नाम"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edtRegVillage"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. बर्दि‍या अमरा" />

                        <Button
                            android:id="@+id/btnGpsDetectVillage"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="📍 GPS"
                            android:textColor="#166534" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="10-अंकों का WhatsApp / कॉलिंग नंबर"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtRegPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="उदा. 8871291126"
                        android:inputType="phone"
                        android:maxLength="10" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="सुरक्षा के लिए 6-अंकों का नया PIN बनाएँ"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtRegPin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="उदा. 123456"
                        android:inputType="numberPassword"
                        android:maxLength="6" />

                    <Button
                        android:id="@+id/btnSubmitRegister"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="18dp"
                        android:backgroundTint="#166534"
                        android:text="🎉 खाता बनाएँ व शुरू करें"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ================= कार्ड 3: PIN भूलने पर रीसेट दृश्य ================= -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardResetPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="नया 6-अंकों का PIN सेट करें"
                        android:textColor="#DC2626"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="पहचान सत्यापित हो चुकी है। अब अपनी पसंद का नया 6-अंकों का PIN दर्ज करें:"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/edtNewResetPin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="नया 6-अंकों का PIN (उदा. 654321)"
                        android:inputType="numberPassword"
                        android:maxLength="6" />

                    <Button
                        android:id="@+id/btnSaveNewPin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#166534"
                        android:text="💾 नया PIN सुरक्षित करें"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
