<?xml version="1.0" encoding="utf-8"?>
<!-- File Path: app/src/main/res/layout/activity_login.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="VERTICAL"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌱 Mera Kisan Partner"
            android:textColor="#1B5E20"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="किसान साथी पोर्टल | सीधी बिक्री, सही भाव"
            android:textColor="#555555"
            android:textSize="14sp" />

        <!-- 1. गूगल लॉगिन कार्ड -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardGoogleLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="VERTICAL"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="कदम 1: पहचान सत्यापन"
                    android:textColor="#2E7D32"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="शुरू करने के लिए अपने Google / Gmail खाते से लॉगिन करें।"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnGoogleSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#DB4437"
                    android:text="G  Google खाते से आगे बढ़ें"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. ऑटो-गाँव + WhatsApp नंबर + 6-डिजिट पिन कार्ड -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRegisterDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:elevation="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="VERTICAL"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="कदम 2: खेत का स्थान व सुरक्षा विवरण"
                    android:textColor="#1B5E20"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtGoogleAccountName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Google खाता: farmer@gmail.com"
                    android:textColor="#0D47A1"
                    android:textSize="13sp" />

                <!-- गाँव ऑटो-डिटेक्ट सेक्शन -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="गाँव का नाम (सटीक GPS लोकेशन से)"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="HORIZONTAL">

                    <EditText
                        android:id="@+id/edtVillage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="गाँव खोजा जा रहा है..."
                        android:inputType="textPostalAddress" />

                    <Button
                        android:id="@+id/btnDetectVillage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#388E3C"
                        android:text="📍 ऑटो GPS"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtLocationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS से सटीक गाँव पकड़ा जा रहा है..."
                    android:textColor="#2E7D32"
                    android:textSize="11sp" />

                <!-- WhatsApp नंबर -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="WhatsApp मोबाइल नंबर"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*ग्राहक ऑर्डर इसी नंबर पर भेजेंगे और एडमिन सत्यापन कॉल इसी पर आएगा"
                    android:textColor="#D84315"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/edtWhatsAppNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="10 अंकों का WhatsApp नंबर"
                    android:inputType="phone"
                    android:maxLength="10" />

                <!-- 6-डिजिट पिन -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="6-अंकों का गुप्त सुरक्षा पिन (PIN)"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="उदा. 123456"
                    android:inputType="numberPassword"
                    android:maxLength="6" />

                <Button
                    android:id="@+id/btnSubmitRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#1B5E20"
                    android:text="खाता पंजीकृत करें व ऐप खोलें 👉"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. मौजूदा किसान के लिए 6-अंकों का पिन लॉगिन -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPinLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:elevation="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="VERTICAL"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="सुरक्षा पिन दर्ज करें"
                    android:textColor="#1B5E20"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtWelcomeBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="नमस्ते किसान साथी, अपना 6-अंकों का पिन डालें:"
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/edtLoginPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="6-अंकों का PIN"
                    android:inputType="numberPassword"
                    android:maxLength="6" />

                <Button
                    android:id="@+id/btnLoginWithPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#2E7D32"
                    android:text="लॉगिन करें 🔓"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ProgressBar
            android:id="@+id/loginProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
