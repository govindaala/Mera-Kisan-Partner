<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/dialog_make_offer.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤝 भाव प्रस्ताव भेजें (Make Offer)"
            android:textColor="#1B5E20"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCurrentListedPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#757575"
            android:textSize="13sp"
            tools:text="वर्तमान कीमत: ₹46 / kg" />

        <!-- Quantity Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilQuantity"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="मात्रा दर्ज करें (kg)"
            app:boxStrokeColor="#1B5E20">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Offered Price Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilOfferedPrice"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="आपकी प्रस्तावित दर प्रति kg (₹)"
            app:boxStrokeColor="#1B5E20">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOfferedPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Offer Total Estimation -->
        <TextView
            android:id="@+id/tvOfferTotalEstimation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#E65100"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="कुल प्रस्तावित राशि: ₹0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelOffer"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="रद्द करें"
                android:textColor="#757575" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitOffer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#1B5E20"
                android:text="प्रस्ताव भेजें"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
