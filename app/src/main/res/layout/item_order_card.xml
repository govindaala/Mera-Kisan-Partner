<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/item_order_card.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Order Header: ID & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#757575"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="ऑर्डर #ORD_894123" />

            <TextView
                android:id="@+id/tvOrderStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8F5E9"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#1B5E20"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="PLACED" />
        </LinearLayout>

        <!-- Product Name & Variety -->
        <TextView
            android:id="@+id/tvOrderProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#1B5E20"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="देशी सोयाबीन (JS 335)" />

        <!-- Quantity & Total Price (Integer Paise) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#424242"
                android:textSize="13sp"
                tools:text="मात्रा: 10 kg" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="10dp"
                android:background="#BDBDBD" />

            <TextView
                android:id="@+id/tvOrderTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="कुल: ₹460" />
        </LinearLayout>

        <!-- Payment Status Strip -->
        <TextView
            android:id="@+id/tvOrderPaymentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#E65100"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="भुगतान स्थिति: COD_PENDING" />

        <!-- Date & Delivery Info -->
        <TextView
            android:id="@+id/tvOrderDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            tools:text="दिनांक: 10 अक्टूबर 2026 • किसान डिलीवरी" />

        <!-- Actions Strip -->
        <LinearLayout
            android:id="@+id/llOrderActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrderDetails"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="विवरण देखें"
                android:textColor="#1B5E20"
                android:textSize="12sp"
                app:strokeColor="#1B5E20" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
