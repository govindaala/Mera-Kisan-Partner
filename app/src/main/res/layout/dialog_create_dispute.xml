<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/dialog_create_dispute.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ विवाद / शिकायत दर्ज करें"
                android:textColor="#D32F2F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="निष्पक्ष समाधान के लिए कृपया समस्या का सही कारण और साक्ष्य दें।"
                android:textColor="#616161"
                android:textSize="12sp" />

            <!-- Reason Dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDisputeReason"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="समस्या का मुख्य कारण चुनें"
                app:boxStrokeColor="#1B5E20">

                <AutoCompleteTextView
                    android:id="@+id/actvDisputeReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Detailed Explanation Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDisputeDescription"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="विस्तृत विवरण (कम से कम 10 शब्द)"
                app:boxStrokeColor="#1B5E20">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDisputeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:lines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Evidence Photo Picker Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPickEvidencePhoto"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FBE9E7"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#FFCCBC"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivEvidencePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="साक्ष्य फ़ोटो"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/llEvidencePlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📷 फ़ोटो साक्ष्य जोड़ें (वैकल्पिक)"
                            android:textColor="#D32F2F"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="प्राप्त माल या समस्या की स्पष्ट तस्वीर"
                            android:textColor="#8D6E63"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelDispute"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="रद्द करें"
                    android:textColor="#757575" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitDispute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#D32F2F"
                    android:text="विवाद सबमिट करें"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</com.google.android.material.card.MaterialCardView>
