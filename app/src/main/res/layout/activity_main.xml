<?xml version="1.0" encoding="utf-8"?>
<!-- File Path: app/src/main/res/layout/activity_main.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- शीर्ष हेडर (Top Bar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#166534"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtHeaderFarmerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱 Mera Kisan Partner"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHeaderVillage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="📍 स्थान लोड हो रहा है..."
                android:textColor="#BBF7D0"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnHelpDispute"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#DC2626"
            android:text="📢 सहायता / शिकायत"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- नेविगेशन टैब बार (4 मुख्य टैब्स) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingHorizontal="4dp">

        <Button
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="#166534"
            android:text="📊 ओवरव्यू"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabMyCrops"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="#E2E8F0"
            android:text="🌾 फ़सलें"
            android:textColor="#334155"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabAddCrop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="#E2E8F0"
            android:text="➕ नई फ़सल"
            android:textColor="#334155"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="#E2E8F0"
            android:text="👤 प्रोफ़ाइल"
            android:textColor="#334155"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- स्क्रॉलेबल मुख्य सामग्री -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ==================== TAB 1: ओवरव्यू ==================== -->
        <ScrollView
            android:id="@+id/viewHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- प्रोफ़ाइल स्टेटस क्विक कार्ड -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ECFDF5"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtHomeBadgeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ Mera Kisan पार्टनर"
                            android:textColor="#166534"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtHomeProfileScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="आपकी प्रोफ़ाइल 70% पूर्ण है"
                            android:textColor="#047857"
                            android:textSize="13sp" />

                        <ProgressBar
                            android:id="@+id/pbHomeProfile"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="70"
                            android:progressTint="#166534" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- क्विक स्टेट्स -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="सक्रिय फ़सलें"
                                android:textColor="#64748B"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtStatCropsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textColor="#0F172A"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="खाता स्थिति"
                                android:textColor="#64748B"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtStatStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="सत्यापित ✓"
                                android:textColor="#16A34A"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- नई फ़सल जोड़ने का क्विक बटन -->
                <Button
                    android:id="@+id/btnQuickAddCrop"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#166534"
                    android:text="➕ नई फ़सल मंडी में जोड़ें"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

        <!-- ==================== TAB 2: मेरी फ़सलें ==================== -->
        <ScrollView
            android:id="@+id/viewMyCrops"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/containerCropsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNoCropsNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:text="🌾 अभी कोई फ़सल लिस्ट नहीं है।\n'नई फ़सल' टैब से अपनी उपज जोड़ें!"
                    android:textColor="#64748B"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ==================== TAB 3: फ़सल जोड़ें ==================== -->
        <ScrollView
            android:id="@+id/viewAddCrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌾 नई फ़सल मंडी में दर्ज करें"
                    android:textColor="#166534"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="फ़सल का नाम व किस्म (उदा. शरबती गेहूँ)"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtAddCropName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="उदा. शरबती गेहूँ (पूसा किरण)"
                    android:inputType="text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="भाव (₹ प्रति किलो)"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtAddPrice"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="उदा. 38 (₹38/kg = ₹3,800/क्विंटल)"
                    android:inputType="numberDecimal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="उपलब्ध कुल स्टॉक (किलो में)"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtAddStock"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="उदा. 2000 (20 क्विंटल)"
                    android:inputType="number" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="खेती का प्रकार"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spnFarmingType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown" />

                <Button
                    android:id="@+id/btnSubmitNewCrop"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="22dp"
                    android:backgroundTint="#166534"
                    android:text="✓ फ़सल मंडी में लाइव करें"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <!-- ==================== TAB 4: प्रोफ़ाइल व जैविक सर्टिफ़िकेट ==================== -->
        <ScrollView
            android:id="@+id/viewProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- प्रोफ़ाइल स्कोर कार्ड -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#166534"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/txtProfileScorePercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="70% पूर्ण"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtProfileBadgeStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="🥈 सत्यापित किसान साथी"
                            android:textColor="#BBF7D0"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pbProfileFull"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="10dp"
                            android:max="100"
                            android:progress="70"
                            android:progressTint="#4ADE80" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="💡 रकबा और जैविक सर्टिफ़िकेट जोड़कर 100% पूरा करें और ⭐ Gold Partner बैज पाएं!"
                            android:textColor="#F0FDF4"
                            android:textSize="11sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- प्रोफ़ाइल इनपुट फ़ील्ड्स -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="खेत का रकबा / ज़मीन (बीघा या एकड़ में)"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtProfileLand"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="उदा. 5 बीघा या 2 एकड़"
                    android:inputType="text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="बैंक UPI ID (पेमेंट सीधे बैंक में पाने के लिए)"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtProfileUpi"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="उदा. 9876543210@paytm या okaxis"
                    android:inputType="textEmailAddress" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🌱 जैविक प्रमाण-पत्र (Organic Certificate - वैकल्पिक)"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtProfileOrganicCert"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="उदा. PGS-India / NPOP Cert No. या विवरण"
                    android:inputType="text" />

                <Button
                    android:id="@+id/btnSaveProfileUpdates"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#166534"
                    android:text="💾 प्रोफ़ाइल अपडेट करें"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</LinearLayout>
