<?xml version="1.0" encoding="utf-8"?>
<!-- File Path: app/src/main/res/layout/activity_main.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <!-- 1. शीर्ष हेडर (Top Bar) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:background="#166534"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌱 Mera Kisan Partner"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHeaderVillage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#15803D"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="📍 गाँव"
            android:textColor="#FEF08A"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. मुख्य कंटेनर (Four Tab Views) -->
    <FrameLayout
        android:id="@+id/tabContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:layout_below="@+id/topBar">

        <!-- ================= TAB 1: होम / नई फ़सल ================= -->
        <ScrollView
            android:id="@+id/viewTabHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- AI वॉइस असिस्टेंट कार्ड -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#ECFDF5"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <Button
                            android:id="@+id/btnVoiceInput"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:backgroundTint="#166534"
                            android:text="🎙️ बोलकर फ़सल भरें (AI Voice)"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtVoiceStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="बोलें: '20 क्विंटल शरबती गेहूँ 38 रुपये किलो'"
                            android:textColor="#047857"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- नई फ़सल फ़ॉर्म कार्ड -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌾 नई फ़सल लिस्ट करें"
                            android:textColor="#166534"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="फ़सल का नाम व किस्म"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtCropName"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. शरबती गेहूँ (पूसा किरण)"
                            android:inputType="text" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="भाव (₹ प्रति किलो)"
                                    android:textColor="#475569"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <EditText
                                    android:id="@+id/edtPrice"
                                    android:layout_width="match_parent"
                                    android:layout_height="46dp"
                                    android:background="@android:drawable/edit_text"
                                    android:hint="उदा. 38"
                                    android:inputType="numberDecimal" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="कुल स्टॉक (किलो)"
                                    android:textColor="#475569"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <EditText
                                    android:id="@+id/edtQty"
                                    android:layout_width="match_parent"
                                    android:layout_height="46dp"
                                    android:background="@android:drawable/edit_text"
                                    android:hint="उदा. 2000"
                                    android:inputType="number" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="खेती का प्रकार"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spnFarmingType"
                            android:layout_width="match_parent"
                            android:layout_height="46dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="गुणवत्ता टैग"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtQualityTag"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. Grade-A सुपर बोल्ड, साफ बीना हुआ"
                            android:inputType="text" />

                        <Button
                            android:id="@+id/btnSubmitCrop"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="#166534"
                            android:text="🚀 फ़सल सेव करें व HD पोस्टर बनाएँ"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="10dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- HD पोस्टर प्रिव्यू व शेयर कार्ड -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPosterSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎉 अल्ट्रा HD मंडी पोस्टर तैयार है:"
                            android:textColor="#166534"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/imgPosterPreview"
                            android:layout_width="match_parent"
                            android:layout_height="380dp"
                            android:layout_marginTop="10dp"
                            android:adjustViewBounds="true"
                            android:background="#0F172A"
                            android:scaleType="fitCenter" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnShareWhatsApp"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:backgroundTint="#25D366"
                                android:text="WhatsApp शेयर"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnShareFacebook"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:backgroundTint="#1877F2"
                                android:text="Facebook शेयर"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 2: मेरी फ़सलें ================= -->
        <ScrollView
            android:id="@+id/viewTabCrops"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌾 मेरी सक्रिय फ़सलें"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnRefreshMyCrops"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="#E2E8F0"
                        android:text="🔄 रीफ़्रेश"
                        android:textColor="#334155"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtMyCropsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="फ़सलें लोड हो रही हैं..."
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/layoutMyCropsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 3: आर्डर बॉक्स ================= -->
        <ScrollView
            android:id="@+id/viewTabOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📦 ग्राहक आर्डर बॉक्स"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnRefreshOrders"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="#E2E8F0"
                        android:text="🔄 रीफ़्रेश"
                        android:textColor="#334155"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtOrdersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="आर्डर लोड हो रहे हैं..."
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/layoutOrdersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- ================= TAB 4: फेसबुक-स्टाइल सोशल प्रोफ़ाइल ================= -->
        <ScrollView
            android:id="@+id/viewTabProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. सोशल कवर फोटो -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="#15803D">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="🚜 Mera Kisan Verified Farm"
                        android:textColor="#86EFAC"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- 2. प्रोफ़ाइल अवतार व विवरण कार्ड -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="-40dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- गोल अवतार -->
                            <TextView
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="#166534"
                                android:gravity="center"
                                android:text="👨‍🌾"
                                android:textSize="32sp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/txtProfileName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="गोविंद राम पाटीदार"
                                        android:textColor="#0F172A"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:background="#DCFCE7"
                                        android:paddingHorizontal="6dp"
                                        android:paddingVertical="2dp"
                                        android:text="✓ सत्यापित किसान"
                                        android:textColor="#166534"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/txtProfileVillage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="📍 बर्दि‍या अमरा, मन्दसौर (म.प्र.)"
                                    android:textColor="#64748B"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/txtProfilePhone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="📱 +91 9876543210"
                                    android:textColor="#0369A1"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- किसान बायो -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="#F8FAFC"
                            android:padding="10dp"
                            android:text="🌾 शुद्ध देसी व जैविक खेती | सीधे खेत से उचित भाव पर आपूर्ति | बिना किसी बिचौलिए की शुद्धता की गारंटी।"
                            android:textColor="#475569"
                            android:textSize="12sp" />

                        <!-- शेयर डिजिटल दुकान बटन -->
                        <Button
                            android:id="@+id/btnShareStore"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#25D366"
                            android:text="🌐 अपनी डिजिटल दुकान WhatsApp पर शेयर करें"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. बैंक UPI ID सेटअप कार्ड -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏦 बैंक UPI ID (पेमेंट टोकन प्राप्ति हेतु)"
                            android:textColor="#166534"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="जब भी ग्राहक ऑनलाइन आर्डर करेगा, डिलीवरी पुष्टि के बाद आपका 8% टोकन सीधे इसी UPI पर ट्रांसफर होगा।"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/edtFarmerUpi"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. 9876543210@upi या kisan@okhdfcbank"
                            android:inputType="textEmailAddress" />

                        <Button
                            android:id="@+id/btnSaveUpi"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="#166534"
                            android:text="💾 UPI ID सुरक्षित करें"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- 3. आधुनिक 4-टैब बॉटम नेविगेशन (Bottom Bar) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="होम"
                android:textColor="#166534"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCrops"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌾"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtNavCrops"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="मेरी फ़सलें"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtNavOrders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="आर्डर"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👨‍🌾"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtNavProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="प्रोफ़ाइल"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
