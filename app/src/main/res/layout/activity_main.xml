<?xml version="1.0" encoding="utf-8"?>
<!-- File Path: app/src/main/res/layout/activity_main.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <!-- 1. टॉप हेडर बार -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#166534"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱 Mera Kisan Partner"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="किसान डिजिटल मंडी साथी"
                android:textColor="#BBF7D0"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnHelpDispute"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#14532D"
            android:paddingHorizontal="12dp"
            android:text="📢 सहायता"
            android:textColor="#FEF08A"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. बॉटम 4-टैब नेविगेशन बार -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="#14532D"
        android:orientation="horizontal"
        android:padding="3dp">

        <Button
            android:id="@+id/btnNavOverview"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#22C55E"
            android:text="📊 ओवरव्यू"
            android:textColor="#052E16"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNavCrops"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="🌾 मेरी फ़सलें"
            android:textColor="#BBF7D0"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnNavAddCrop"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="➕ नया उत्पाद"
            android:textColor="#BBF7D0"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnNavProfile"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="👤 प्रोफ़ाइल"
            android:textColor="#BBF7D0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 3. मुख्य कंटेंट कंटेनर (4 व्यूज) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavLayout"
        android:layout_below="@id/topBarLayout">

        <!-- ================= दृश्य 1: डैशबोर्ड व ओवरव्यू ================= -->
        <ScrollView
            android:id="@+id/viewOverview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- किसान वेलकम कार्ड -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtWelcomeFarmer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="नमस्ते, किसान साथी!\n📍 गाँव: बर्दि‍या अमरा"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- प्रोफ़ाइल पूर्णता मीटर -->
                        <TextView
                            android:id="@+id/txtProfileCompletePercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="प्रोफ़ाइल पूर्णता: 40%"
                            android:textColor="#166534"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progressProfileCompletion"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="6dp"
                            android:max="100"
                            android:progress="40"
                            android:progressTint="#16A34A" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- आँकड़े कार्ड -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="सक्रिय फ़सलें / उत्पाद"
                                android:textColor="#64748B"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtActiveCropsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textColor="#166534"
                                android:textSize="26sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="बिचौलिया कमीशन"
                                android:textColor="#64748B"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0%"
                                android:textColor="#0284C7"
                                android:textSize="26sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- त्वरित सहायता बैनर -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#FEF3C7"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡 किसान भाइयों के लिए सलाह:"
                            android:textColor="#92400E"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="अपनी फ़सल जोड़ने के बाद 'AI पोस्टर' बटन दबाएँ। WhatsApp पर ऐसा ग्राफ़िक पोस्टर शेयर होगा जिसे देखकर ग्राहक सीधे आपसे सौदा करेंगे।"
                            android:textColor="#78350F"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

        <!-- ================= दृश्य 2: मेरी फ़सलें (Crops List) ================= -->
        <ScrollView
            android:id="@+id/viewCrops"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌾 आपकी मंडी में लाइव फ़सलें व उत्पाद"
                    android:textColor="#166534"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/cropsProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/containerFarmerCrops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- ================= दृश्य 3: नया उत्पाद जोड़ें (7 श्रेणियों सहित) ================= -->
        <ScrollView
            android:id="@+id/viewAddCrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="➕ नई फ़सल या उत्पाद जोड़ें"
                            android:textColor="#166534"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- 📂 7 श्रेणियों का ड्रॉपडाउन -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="📂 उत्पाद की श्रेणी (Category)"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spnCategory"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@android:drawable/btn_dropdown" />

                        <!-- उत्पाद का नाम -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="🌾 उत्पाद / फ़सल का नाम"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtCropName"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. चीना पोसो मिलेट, सरसों का तेल, देशी गुड़" />

                        <!-- भाव -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="💰 भाव (₹ प्रति किलो या लीटर)"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtCropPrice"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. 50 (यानी ₹5000/क्विंटल)"
                            android:inputType="numberDecimal" />

                        <!-- स्टॉक -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="📦 उपलब्ध कुल स्टॉक (किलो या लीटर में)"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtCropStock"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. 600"
                            android:inputType="numberDecimal" />
                                                <!-- फ़सल का विवरण (Description) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="📝 फ़सल / उत्पाद का विवरण (Description)"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtCropDesc"
                            android:layout_width="match_parent"
                            android:layout_height="75dp"
                            android:background="@android:drawable/edit_text"
                            android:gravity="top|start"
                            android:hint="उदा. दाने की क्वालिटी, पैकिंग साइज़, शुद्धता या अन्य विशेषता..."
                            android:inputType="textMultiLine"
                            android:padding="8dp" />
                        

                        <!-- जैविक चेकबॉक्स -->
                        <CheckBox
                            android:id="@+id/chkIsOrganic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="🛡️ यह 100% प्राकृतिक एवं जैविक (Organic) उत्पाद है"
                            android:textColor="#166534"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/addCropProgressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="10dp"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/btnSubmitCrop"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="#166534"
                            android:text="🚀 मंडी में लाइव पोस्ट करें"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

        <!-- ================= दृश्य 4: किसान प्रोफ़ाइल व सेटिंग्स ================= -->
        <ScrollView
            android:id="@+id/viewProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👤 किसान सत्यापन एवं प्रोफ़ाइल"
                            android:textColor="#166534"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="🌾 कुल खेती योग्य रकबा (बीघा / एकड़)"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtProfileLand"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. 15 बीघा" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="💳 भुगतान हेतु UPI ID (PhonePe/GPay)"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtProfileUpi"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. 8871291126@ybl" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="🛡️ जैविक प्रमाण-पत्र संख्या (यदि हो तो)"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtProfileCert"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. MP-NPOP-2024" />

                        <Button
                            android:id="@+id/btnSaveProfile"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="#166534"
                            android:text="💾 प्रोफ़ाइल सुरक्षित करें"
                            android:textColor="#FFFFFF" />

                        <Button
                            android:id="@+id/btnLogout"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:text="🚪 लॉगआउट करें"
                            android:textColor="#DC2626" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</RelativeLayout>
