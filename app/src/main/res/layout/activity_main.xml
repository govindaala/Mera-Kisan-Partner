<?xml version="1.0" encoding="utf-8"?>
<!-- File Path: app/src/main/res/layout/activity_main.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <!-- 1. टॉप हेडर बार -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#166534"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌱 Mera Kisan Partner"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHeaderVillage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#14532D"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="📍 -"
                android:textColor="#BBF7D0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtHeaderFarmerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="किसान साथी: -"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 2. नीचे का नेविगेशन बार (4 टैब) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNavOverview"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📊 ओवरव्यू"
            android:textColor="#166534"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNavMyCrops"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🌾 फ़सलें"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnNavAddCrop"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="➕ जोड़ें"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnNavProfile"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="👨‍🌾 प्रोफ़ाइल"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 3. मुख्य कंटेंट स्क्रॉल व्यू -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar"
        android:layout_below="@id/headerBar"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- TAB 1: ओवरव्यू -->
            <LinearLayout
                android:id="@+id/tabOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ECFDF5"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtOverviewProfileStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="आपकी प्रोफ़ाइल: 70% पूर्ण है 🥈"
                            android:textColor="#065F46"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pbOverviewProfile"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="70"
                            android:progressTint="#16A34A" />

                        <TextView
                            android:id="@+id/txtOverviewProfileTip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="💡 बैंक UPI और रकबा जोड़कर 100% गोल्ड बैज पाएँ।"
                            android:textColor="#047857"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="मंडी में सीधी बिक्री शुरू करें"
                            android:textColor="#166534"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="अपनी फ़सल लिस्ट करें, अल्ट्रा HD मंडी पोस्टर बनाएं और सीधे WhatsApp पर खरीदारों को भेजें।"
                            android:textColor="#64748B"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnQuickAddCrop"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#166534"
                            android:text="➕ नई फ़सल लिस्ट करें"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- TAB 2: मेरी फ़सलें -->
            <LinearLayout
                android:id="@+id/tabMyCrops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌾 आपकी लिस्टेड फ़सलें"
                        android:textColor="#1E293B"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnRefreshCrops"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔄 रीफ़्रेश"
                        android:textColor="#166534"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerCropsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtNoCropsNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:text="अभी कोई फ़सल लिस्टेड नहीं है।\n'➕ जोड़ें' टैब से पहली फ़सल जोड़ें!"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- TAB 3: फ़सल जोड़ें -->
            <LinearLayout
                android:id="@+id/tabAddCrop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌾 नई फ़सल मंडी में दर्ज करें"
                            android:textColor="#166534"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="फ़सल का नाम व किस्म"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtAddCropName"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. शरबती गेहूँ (पूसा किरण)"
                            android:inputType="text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="भाव (₹ प्रति किलो)"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtAddCropPrice"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. 38 (यानी ₹3,800/क्विंटल)"
                            android:inputType="numberDecimal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="उपलब्ध कुल स्टॉक (किलो में)"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtAddCropStock"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. 2000 (यानी 20 क्विंटल)"
                            android:inputType="number" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="खेती का प्रकार"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spnAddCropFarmingType"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/btn_dropdown" />

                        <Button
                            android:id="@+id/btnSubmitNewCrop"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="18dp"
                            android:backgroundTint="#166534"
                            android:text="🚀 फ़सल मंडी में लाइव करें"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- TAB 4: प्रोफ़ाइल व सहायता -->
            <LinearLayout
                android:id="@+id/tabProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/txtProfileScoreTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="आपकी प्रोफ़ाइल: 70% पूर्ण है 🥈"
                            android:textColor="#166534"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pbProfileFull"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="70"
                            android:progressTint="#16A34A" />

                        <TextView
                            android:id="@+id/txtGoldBadgeNotice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="⭐ 100% पूरा करने पर गोल्ड पार्टनर बैज प्राप्त होगा"
                            android:textColor="#0369A1"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="खेत का रकबा (बीघा / एकड़ - वैकल्पिक)"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtProfileLand"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. 5 बीघा या 2 एकड़"
                            android:inputType="text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="बैंक UPI ID (टोकन पेमेंट के लिए)"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtProfileUpi"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="उदा. kisan@upi या मोबाइल@ybl"
                            android:inputType="textEmailAddress" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="🌱 जैविक प्रमाण-पत्र (वैकल्पिक)"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtProfileOrganicCert"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="PGS-India / NPOP नंबर या संस्था का नाम"
                            android:inputType="text" />

                        <Button
                            android:id="@+id/btnSaveProfileUpdates"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="#166534"
                            android:text="💾 प्रोफ़ाइल अपडेट सुरक्षित करें"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- सहायता व शिकायत कार्ड -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📢 सहायता व शिकायत डेस्क"
                            android:textColor="#DC2626"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="किसी सौदे या ऐप को लेकर समस्या होने पर सीधे एडमिन को संदेश भेजें:"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spnDisputeIssueType"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="10dp"
                            android:background="@android:drawable/btn_dropdown" />

                        <EditText
                            android:id="@+id/edtDisputeOrderId"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="आर्डर ID (यदि किसी आर्डर को लेकर है)"
                            android:inputType="text" />

                        <EditText
                            android:id="@+id/edtDisputeMessage"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:gravity="top|start"
                            android:hint="अपनी समस्या विस्तार से लिखें..."
                            android:inputType="textMultiLine" />

                        <Button
                            android:id="@+id/btnSubmitDispute"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#DC2626"
                            android:text="✉️ एडमिन को शिकायत भेजें"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- लॉगआउट बटन -->
                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#64748B"
                    android:text="🔒 लॉगआउट करें"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</RelativeLayout>
