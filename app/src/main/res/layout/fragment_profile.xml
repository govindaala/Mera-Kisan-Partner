<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/fragment_profile.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- TOP BAR TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="👤 मेरी प्रोफ़ाइल व खाता नियंत्रण"
            android:textColor="#1B5E20"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- 1. IDENTITY CARD (Fixed Avatar 'G' + Full Name, Email, Location & Badge) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Single Character Avatar Box -->
                    <TextView
                        android:id="@+id/tv_avatar_initial"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="#E8F5E9"
                        android:gravity="center"
                        android:maxLength="2"
                        android:singleLine="true"
                        android:text="G"
                        android:textColor="#1B5E20"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Right Side User Details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_profile_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="किसान साथी"
                            android:textColor="#212121"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_profile_contact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="सत्यापित Google खाता"
                            android:textColor="#616161"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_profile_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="📍 गरोठ, मंदसौर (मध्य प्रदेश)"
                            android:textColor="#2E7D32"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_verification_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:background="#E8F5E9"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="✔ किसान द्वारा घोषित (Farmer Declared)"
                            android:textColor="#1B5E20"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_edit_profile"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="बदलें"
                        android:textColor="#1B5E20"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#F9FBE7"
                    android:padding="8dp"
                    android:text="🛡️ गोपनीयता सुरक्षित: आपका सटीक GPS कभी सार्वजनिक नहीं किया जाता; केवल गांव व लगभग दूरी दिखती है।"
                    android:textColor="#558B2F"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. ROLE SWITCHER CARD (Farmer / Buyer / Both) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="🔄 सक्रिय भूमिका बदलें (Switch App Mode)"
                    android:textColor="#1B5E20"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_role_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rb_role_farmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="🌾 किसान - विक्रेता मोड (केवल फसल बेचें, मंडी व बिक्री ऑर्डर्स)"
                        android:textColor="#212121"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rb_role_buyer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="🛒 खरीदार मोड (केवल फसलें खोजें, खरीदें व 'मुझे चाहिए' मांग डालें)"
                        android:textColor="#212121"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rb_role_both"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="⚡ दोनों मोड — डबल विकल्प (खरीदें और बेचें के सारे विकल्प एक साथ)"
                        android:textColor="#1B5E20"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. FARMER / SELLER OPTIONS SECTION (Visible in FARMER & BOTH Modes) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_farmer_quick_links"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="🌾 किसान - विक्रेता प्रबंधन (Seller Desk)"
                    android:textColor="#1B5E20"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_add_new_crop_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:text="➕ नई फसल / उत्पाद सूचीबद्ध करें (Add Crop)"
                    android:textColor="#212121"
                    android:textSize="14sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <TextView
                    android:id="@+id/btn_manage_crops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:text="🌿 मेरी सूचीबद्ध फसलें (Active / Sold / Draft)"
                    android:textColor="#212121"
                    android:textSize="14sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <TextView
                    android:id="@+id/btn_farmer_sales_orders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:text="📦 प्राप्त बिक्री ऑर्डर्स व भुगतान (Seller Orders)"
                    android:textColor="#212121"
                    android:textSize="14sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <TextView
                    android:id="@+id/btn_farmer_verification_kyc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:text="🏅 किसान सत्यापन व जैविक प्रमाणपत्र अपलोड (6-Level Trust)"
                    android:textColor="#212121"
                    android:textSize="14sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <TextView
                    android:id="@+id/btn_farmer_story"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:text="📖 मेरी खेती की कहानी व शेयर एनालिटिक्स (Farm Story)"
                    android:textColor="#212121"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. BUYER / CONSUMER OPTIONS SECTION (Visible in BUYER & BOTH Modes) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_buyer_quick_links"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="🛒 खरीदार - ग्राहक विकल्प (Buyer Desk)"
                    android:textColor="#0D47A1"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_order_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:text="🛍️ मेरे खरीद ऑर्डर्स व डिलीवरी ट्रैक करें (My Orders)"
                    android:textColor="#212121"
                    android:textSize="14sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <TextView
                    android:id="@+id/btn_buyer_requests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:text="📢 मेरी मांगें ('मुझे यह चाहिए' डिमांड बोर्ड)"
                    android:textColor="#212121"
                    android:textSize="14sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <TextView
                    android:id="@+id/btn_my_offers_negotiations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:text="🤝 मेरे भाव प्रस्ताव व मोलभाव (Offers &amp; Counter-Offers)"
                    android:textColor="#212121"
                    android:textSize="14sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <TextView
                    android:id="@+id/btn_favorites_followed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:text="❤️ पसंदीदा फसलें, फॉलो किए किसान व भाव अलर्ट"
                    android:textColor="#212121"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 5. MARKETPLACE INTELLIGENCE & SUPPORT -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="⚙️ मंडी, सहायता व खाता सेटिंग्स"
                    android:textColor="#424242"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_profile_mandi_rates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:text="📈 लाइव मंडी भाव व पुराना इतिहास (APMC Mandi)"
                    android:textColor="#212121"
                    android:textSize="14sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <TextView
                    android:id="@+id/btn_whatsapp_support"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:text="🟢 सहायता केंद्र व विवाद समाधान (Help &amp; Disputes)"
                    android:textColor="#212121"
                    android:textSize="14sp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="📱 ऐप संस्करण: v1.1.0 (Master Unified Build)"
                    android:textColor="#757575"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 6. LOGOUT BUTTON -->
        <Button
            android:id="@+id/btn_logout"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp"
            android:text="सत्र समाप्त करें (लॉगआउट)"
            android:textColor="#C62828"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
