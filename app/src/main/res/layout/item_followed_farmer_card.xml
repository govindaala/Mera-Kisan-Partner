<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/item_followed_farmer_card.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#C8E6C9"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Farmer Initial Frame -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#E8F5E9">

                <TextView
                    android:id="@+id/tvFarmerAvatarInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="R"
                    android:textColor="#1B5E20"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFollowedFarmerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#1B5E20"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="रामलाल पाटीदार" />

                <TextView
                    android:id="@+id/tvFollowedFarmerLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#616161"
                    android:textSize="12sp"
                    tools:text="📍 ग्राम: बर्ड़िया अमरा • ज़िला: मंदसौर" />
            </LinearLayout>

            <!-- Verification Tag -->
            <TextView
                android:id="@+id/tvFarmerVerifiedTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8F5E9"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="✔ Verified" />
        </LinearLayout>

        <!-- Stats Row: Active Crops & Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFarmerActiveCropsCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#424242"
                android:textSize="12sp"
                tools:text="🌾 4 फसलें बिक्री के लिए उपलब्ध" />

            <TextView
                android:id="@+id/tvFarmerRatingDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E65100"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="⭐ 4.8 / 5.0" />
        </LinearLayout>

        <!-- Action Buttons (Call / WhatsApp / Unfollow) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFarmerCall"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="कॉल"
                android:textColor="#1B5E20"
                android:textSize="12sp"
                app:strokeColor="#1B5E20" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFarmerWhatsApp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="व्हाट्सएप"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                app:strokeColor="#2E7D32" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnfollowFarmer"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="अनफ़ॉलो"
                android:textColor="#757575"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
