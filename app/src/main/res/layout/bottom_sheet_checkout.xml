<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/bottom_sheet_checkout.xml -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Drag Handle -->
                <View
                    android:layout_width="48dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp"
                    android:background="#E0E0E0" />

                <!-- Sheet Title & Product Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛒 सुरक्षित ऑर्डर चेकआउट"
                    android:textColor="#1B5E20"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCheckoutProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#424242"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="देशी सोयाबीन (JS 335) • ₹46 / kg" />

                <TextView
                    android:id="@+id/tvCheckoutAvailableStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    tools:text="उपलब्ध स्टॉक: 20 kg • न्यूनतम ऑर्डर: 2 kg" />

                <!-- Quantity Selector Section -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOrderQuantity"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="खरीदने की मात्रा दर्ज करें"
                    app:boxStrokeColor="#1B5E20">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOrderQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Delivery Type Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="डिलीवरी का प्रकार चुनें:"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgDeliveryType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbFarmerDelivery"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="किसान डिलीवरी"
                        android:textColor="#424242"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbBuyerPickup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="खेत से पिकअप"
                        android:textColor="#424242"
                        android:textSize="13sp" />
                </RadioGroup>

                <!-- Delivery Address Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDeliveryAddress"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="डिलीवरी का पता व संपर्क नंबर"
                    app:boxStrokeColor="#1B5E20">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDeliveryAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Payment Method Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="भुगतान का तरीका:"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbPaymentCod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="कैश ऑन डिलीवरी (माल मिलने पर भुगतान)"
                        android:textColor="#424242"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbPaymentOnline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="सुरक्षित ऑनलाइन भुगतान (एस्क्रो सुरक्षा)"
                        android:textColor="#424242"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </RadioGroup>

                <!-- Total Amount Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#F1F8E9"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#C8E6C9"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="कुल देय राशि:"
                                android:textColor="#1B5E20"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCalculatedTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#2E7D32"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="₹0" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="🛡️ Idempotent Checkout: नेटवर्क समस्या होने पर दोहरा भुगतान नहीं होगा।"
                            android:textColor="#757575"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action Confirm Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmOrder"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#1B5E20"
                    android:text="ऑर्डर सुनिश्चित करें (Place Order)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="27dp" />

                <ProgressBar
                    android:id="@+id/pbPlacingOrder"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"
                    android:indeterminateTint="#1B5E20"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
