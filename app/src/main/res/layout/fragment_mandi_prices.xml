<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/fragment_mandi_prices.xml -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF8">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="📊 आज का मंडी भाव (Mandi Rates)"
            app:titleTextColor="#1B5E20" />

        <!-- 6-Hour Smart Caching Transparency Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8F5E9"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="स्रोत: Data.gov.in (Agmarknet) • 6 घंटे स्मार्ट कैशिंग"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMandiLastUpdated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#558B2F"
                android:textSize="11sp"
                tools:text="ताज़ा: 2 घंटे पहले" />
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshMandi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/llMandiContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Fast Filter Search Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSearchCommodity"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="10dp"
                    android:hint="फसल या मंडी खोजें (उदा. सोयाबीन, गरोठ, मंदसौर)"
                    app:boxStrokeColor="#1B5E20"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearchCommodity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Prices List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMandiPrices"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="6dp"
                    android:paddingBottom="90dp"
                    tools:listitem="@layout/item_mandi_price" />

            </LinearLayout>

            <!-- Loading State -->
            <ProgressBar
                android:id="@+id/pbMandiLoading"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="#1B5E20"
                android:visibility="gone" />

            <!-- Empty / Search Not Found State -->
            <LinearLayout
                android:id="@+id/llEmptyMandi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌾"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/tvEmptyMandiTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="मंडी भाव लोड नहीं हुआ"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptyMandiSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="यह सुविधा वर्तमान में एडमिन पैनल से बंद है या आज की नीलामी के आंकड़े अभी दर्ज नहीं हुए हैं।"
                    android:textColor="#757575"
                    android:textSize="13sp" />
            </LinearLayout>

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
