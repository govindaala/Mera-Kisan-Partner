<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/fragment_product_detail.xml -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF8">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="फसल का विवरण"
            app:titleTextColor="#1B5E20" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Media Frame Card (Photo & Video Preview) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="240dp"
                app:cardBackgroundColor="#E8F5E9"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#C8E6C9"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivProductImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="फसल की तस्वीर"
                        android:scaleType="centerCrop"
                        tools:src="@android:drawable/ic_menu_gallery" />

                    <!-- Video Available Badge -->
                    <TextView
                        android:id="@+id/tvVideoBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:background="#B71C1C"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="▶ वीडियो उपलब्ध"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Product Name, Variety, and Pricing Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#1B5E20"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="देशी सोयाबीन (JS 335)" />

                    <TextView
                        android:id="@+id/tvProductVariety"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#616161"
                        android:textSize="13sp"
                        tools:text="किस्म: पीला बोल्ड • श्रेणी: अनाज व तिलहन" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProductPrice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#2E7D32"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="₹46 / kg" />

                        <TextView
                            android:id="@+id/tvStockQuantity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#E8F5E9"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="#1B5E20"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="स्टॉक: 120 kg उपलब्ध" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMinOrder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#757575"
                        android:textSize="12sp"
                        tools:text="न्यूनतम ऑर्डर: 5 kg (छोटी मात्रा में भी उपलब्ध)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Trust & Harvest Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="सत्यापन व खेती का विवरण"
                        android:textColor="#1B5E20"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="सत्यापन स्थिति: "
                            android:textColor="#424242"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvVerificationStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#2E7D32"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="✔ Mera Kisan Verified Farmer" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHarvestDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#424242"
                        android:textSize="13sp"
                        tools:text="कटाई की तारीख: 25 सितम्बर 2026 (ताज़ा फसल)" />

                    <TextView
                        android:id="@+id/tvFarmingType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#424242"
                        android:textSize="13sp"
                        tools:text="खेती का प्रकार: प्राकृतिक देशी खाद आधारित" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Farmer & Location Card (Privacy-First) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="किसान व स्थान (Farmer &amp; Location)"
                        android:textColor="#1B5E20"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFarmerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#212121"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="रामलाल पाटीदार" />

                    <TextView
                        android:id="@+id/tvFarmerLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#616161"
                        android:textSize="13sp"
                        tools:text="📍 ग्राम: बर्ड़िया अमरा • तहसील: गरोठ, ज़िला: मंदसौर" />

                    <!-- Quick Direct Contact Strip -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCallFarmer"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="कॉल करें"
                            android:textColor="#1B5E20"
                            android:textSize="12sp"
                            app:strokeColor="#1B5E20" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWhatsAppFarmer"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="व्हाट्सएप"
                            android:textColor="#2E7D32"
                            android:textSize="12sp"
                            app:strokeColor="#2E7D32" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFollowFarmer"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="फ़ॉलो"
                            android:textColor="#1B5E20"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Description & Produce Notes Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="फसल का विवरण (Description)"
                        android:textColor="#1B5E20"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProductDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#424242"
                        android:textSize="13sp"
                        tools:text="घर के उपयोग के लिए एकदम साफ की गई देशी सोयाबीन। दाना मोटा और पीला है। खेत से सीधे या डिलीवरी द्वारा प्राप्त करें।" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Share & Poster Marketing Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareProduct"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="📢 शेयर करें"
                    android:textColor="#1B5E20"
                    android:textSize="13sp"
                    app:strokeColor="#1B5E20" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGeneratePoster"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🎨 AI पोस्टर बनाएं"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    app:strokeColor="#2E7D32" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar (Buy Now & Negotiation) -->
    <LinearLayout
        android:id="@+id/llBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMakeOffer"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="भाव प्रस्ताव दें"
            android:textColor="#1B5E20"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            app:strokeColor="#1B5E20" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuyNow"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.3"
            android:backgroundTint="#1B5E20"
            android:text="अभी खरीदें (Buy Now)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="26dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
