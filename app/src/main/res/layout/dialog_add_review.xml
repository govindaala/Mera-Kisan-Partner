<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/dialog_add_review.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ फसल व किसान की समीक्षा दें"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="आपकी वास्तविक समीक्षा से अन्य खरीदारों और किसानों को सही जानकारी मिलती है।"
                android:textColor="#616161"
                android:textSize="12sp" />

            <!-- Overall Rating -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="कुल संतुष्टि स्तर (Overall Rating):"
                android:textColor="#212121"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RatingBar
                android:id="@+id/rbOverallRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:numStars="5"
                android:rating="5.0"
                android:stepSize="1.0"
                android:theme="@style/Widget.AppCompat.RatingBar" />

            <!-- Quality Rating -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="फसल की गुणवत्ता व ताज़गी:"
                android:textColor="#212121"
                android:textSize="13sp" />

            <RatingBar
                android:id="@+id/rbQualityRating"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:numStars="5"
                android:rating="5.0"
                android:stepSize="1.0" />

            <!-- Delivery / Handover Rating -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="डिलीवरी समय व किसान का व्यवहार:"
                android:textColor="#212121"
                android:textSize="13sp" />

            <RatingBar
                android:id="@+id/rbDeliveryRating"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:numStars="5"
                android:rating="5.0"
                android:stepSize="1.0" />

            <!-- Comment Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReviewComment"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="अपना अनुभव विस्तार से लिखें..."
                app:boxStrokeColor="#1B5E20">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReviewComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:lines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelReview"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="रद्द करें"
                    android:textColor="#757575" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitReview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#1B5E20"
                    android:text="समीक्षा पोस्ट करें"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</com.google.android.material.card.MaterialCardView>
