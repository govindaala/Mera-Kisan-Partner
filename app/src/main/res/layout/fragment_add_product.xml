<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/fragment_add_product.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- TOP HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="🌾 नई फसल / उत्पाद जोड़ें (10-Step Listing)"
            android:textColor="#1B5E20"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="छोटी मात्रा (1–25 kg) या थोक उपज सीधे ग्राहकों तक पहुंचाएं"
            android:textColor="#616161"
            android:textSize="12sp" />

        <!-- STEP 1 & 6: PHOTO (Google Drive) & VIDEO (YouTube 6/day + Firebase Queue) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <androidx.cardview.widget.CardView
                android:id="@+id/card_pick_photo"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#E8F5E9"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/iv_crop_preview"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_camera" />

                    <TextView
                        android:id="@+id/tv_photo_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="📷 असली फोटो चुनें\n(Drive Metadata)"
                        android:textColor="#1B5E20"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_pick_video"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#E3F2FD"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_media_play" />

                    <TextView
                        android:id="@+id/tv_video_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="🎥 15-30s वीडियो चुनें\n(YouTube + Queue)"
                        android:textColor="#0D47A1"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- STEP 2: PRODUCT NAME, CATEGORY & VARIETY -->
        <EditText
            android:id="@+id/et_product_name"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:background="@android:drawable/edit_text"
            android:hint="फसल / उत्पाद का नाम (उदा. देशी गेहूं, सोयाबीन, मूंगफली तेल)"
            android:inputType="text"
            android:padding="12dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_select_category"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:background="@android:drawable/edit_text"
            android:gravity="center_vertical"
            android:hint="श्रेणी चुनें (Category) ▼"
            android:padding="12dp"
            android:textColor="#212121"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_variety"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:background="@android:drawable/edit_text"
            android:hint="किस्म / Variety (उदा. शरबती, JS 9560, बिना पॉलिश, लकड़ी घानी)"
            android:inputType="text"
            android:padding="12dp"
            android:textSize="14sp" />

        <!-- STEP 3: PRICE & UNIT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <EditText
                android:id="@+id/et_price"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="दर ₹ (प्रति इकाई)"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_select_unit"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="किलो (kg) ▼"
                android:textColor="#212121"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- QUANTITY & SMALL QUANTITY MINIMUM ORDER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <EditText
                android:id="@+id/et_total_quantity"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="कुल उपलब्ध मात्रा"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_min_order_quantity"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="न्यूनतम ऑर्डर (उदा. 1 या 5)"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:text="1"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- STEP 4 & 8: HARVEST DATE & VERIFICATION LEVEL -->
        <TextView
            android:id="@+id/tv_harvest_date"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:background="@android:drawable/edit_text"
            android:gravity="center_vertical"
            android:hint="📅 कटाई तिथि / ताज़ा फसल तिथि चुनें (Harvest Date)"
            android:padding="12dp"
            android:textColor="#212121"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_select_verification"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:background="@android:drawable/edit_text"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="किसान द्वारा घोषित (Farmer Declared) ▼"
            android:textColor="#212121"
            android:textSize="14sp" />

        <!-- DELIVERY / PICKUP OPTION -->
        <TextView
            android:id="@+id/tv_select_delivery"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:background="@android:drawable/edit_text"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="खेत से पिकअप व लोकल डिलीवरी दोनों उपलब्ध ▼"
            android:textColor="#212121"
            android:textSize="14sp" />

        <!-- STEP 7: VILLAGE & DISTRICT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <EditText
                android:id="@+id/et_village"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="ग्राम / कस्बा (उदा. गरोठ)"
                android:inputType="text"
                android:padding="12dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_district"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="ज़िला (उदा. मंदसौर)"
                android:inputType="text"
                android:padding="12dp"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- STEP 5: DESCRIPTION -->
        <EditText
            android:id="@+id/et_description"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="14dp"
            android:background="@android:drawable/edit_text"
            android:gravity="top"
            android:hint="फसल का विवरण (गुणवत्ता, भंडारण विधि, पैकिंग व उपयोग)"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progressBarPublish"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- STEP 10: PUBLISH BUTTON -->
        <Button
            android:id="@+id/btn_publish_crop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#1B5E20"
            android:text="🌾 फसल प्रकाशित करें (PUBLISH CROP)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
