<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/fragment_order_detail.xml -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF8">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="ऑर्डर विवरण व स्थिति"
            app:titleTextColor="#1B5E20" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Order Status Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#C8E6C9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvOrderDetailId"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#757575"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="ऑर्डर #ORD_991823" />

                        <TextView
                            android:id="@+id/tvOrderDetailStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#E8F5E9"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="#1B5E20"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="ACCEPTED" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOrderTimestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp"
                        tools:text="दिनांक: 10 अक्टूबर 2026, 02:15 PM" />

                    <!-- Visual Timeline Progress -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#E0E0E0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ऑर्डर टाइमलाइन (Order Lifecycle):"
                        android:textColor="#212121"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTimelineDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#424242"
                        android:textSize="13sp"
                        tools:text="✔ ऑर्डर दर्ज (PLACED) ➔ ✔ किसान द्वारा स्वीकार (ACCEPTED) ➔ ⏳ रास्ते में (IN_TRANSIT)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Produce & Financial Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="फ़सल एवं भुगतान विवरण"
                        android:textColor="#1B5E20"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOrderDetailProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#212121"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="देशी सोयाबीन (JS 335)" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvOrderDetailQuantity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#424242"
                            android:textSize="13sp"
                            tools:text="मात्रा: 20 kg @ ₹46/kg" />

                        <TextView
                            android:id="@+id/tvOrderDetailTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#2E7D32"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="कुल देय: ₹920.00" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOrderDetailPaymentMethod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#E65100"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="भुगतान विधि: कैश ऑन डिलीवरी (COD_PENDING)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Counterparty Contact & Location Privacy Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvCounterpartyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#757575"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="विक्रेता (किसान) संपर्क" />

                    <TextView
                        android:id="@+id/tvCounterpartyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#1B5E20"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="रामलाल पाटीदार" />

                    <TextView
                        android:id="@+id/tvDeliveryAddressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#424242"
                        android:textSize="13sp"
                        tools:text="डिलीवरी पता: ग्राम बर्ड़िया अमरा, तहसील गरोठ, मंदसौर" />

                    <!-- Quick Call / WhatsApp Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOrderCall"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="कॉल करें"
                            android:textColor="#1B5E20"
                            android:textSize="12sp"
                            app:strokeColor="#1B5E20" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOrderWhatsApp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="व्हाट्सएप"
                            android:textColor="#2E7D32"
                            android:textSize="12sp"
                            app:strokeColor="#2E7D32" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Dispute Card (For Completed or Active Orders) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRaiseDispute"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ इस ऑर्डर में कोई समस्या है? विवाद दर्ज करें"
                    android:textColor="#D32F2F"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar (State Machine Controls) -->
    <LinearLayout
        android:id="@+id/llBottomActionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:padding="12dp">
        <!-- FCM Background Notification Service Registration -->
<service
    android:name=".core.notifications.MeraKisanFirebaseMessagingService"
    android:exported="false">
    <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
    </intent-filter>
</service>
        

        <!-- Farmer Primary Action (Accept / Dispatch) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            tools:text="ऑर्डर स्वीकार करें (Accept Order)" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
